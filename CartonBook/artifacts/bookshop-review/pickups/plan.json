  "id": "bookshop-letter",
  "title": "书店镇 · 门仍开着",
  "subtitle": "霸天舰队来袭之日",
  "scene": "messenger",
  "gameUrl": "/TigerMessenger/?scene=messenger&autostart=1&dev=1&cartonCapture=1",
