   const f=Math.pow(Math.abs(u)/l.rx,2.6)+Math.pow(Math.abs(v)/l.rz,2.6),thr=1+.13*Math.sin(3*a+l.ph[0])+.09*Math.sin(5*a+l.ph[1])+.06*Math.sin(8*a+l.ph[2]);
   if(f<thr&&l.h>best)best=l.h;}return best;};
}

// turquoise shallows: a sheet whose alpha falls off with distance from the nearest rock column
function shallowSheet(cells,ext,cs,bend){const n=Math.ceil(ext*2/2.2),st=ext*2/n,pos=[],col=[],idx=[],c0=new THREE.Color(0x46cbbf);
