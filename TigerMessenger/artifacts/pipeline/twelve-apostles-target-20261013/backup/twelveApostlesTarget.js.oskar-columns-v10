 const add=(a,b)=>{(bnd.get(a)||bnd.set(a,[]).get(a)).push(b);(bnd.get(b)||bnd.set(b,[]).get(b)).push(a);};
 const seen=new Set();for(const c of cells.values()){const{i,j}=c;
  // edges: bottom (i,j)-(i+1,j) vs cell (i,j-1); right (i+1,j)-(i+1,j+1) vs (i+1,j); top vs (i,j+1); left vs (i-1,j)
  const E=[[[i,j],[i+1,j],[i,j-1]],[[i+1,j],[i+1,j+1],[i+1,j]],[[i,j+1],[i+1,j+1],[i,j+1]],[[i,j],[i,j+1],[i-1,j]]];
  for(const[a,b,n]of E){if(lvl(...n)===c.h)continue;const ka=vk(...a),kb=vk(...b),key=ka<kb?ka+'|'+kb:kb+'|'+ka;if(seen.has(key))continue;seen.add(key);add(ka,kb);}}
 const parse=key=>key.split(',').map(Number);
 for(let it=0;it<iters;it++){const moves=[];for(const[key,nb]of bnd){if(nb.length!==2)continue;const v=vert(...parse(key)),a=vert(...parse(nb[0])),b=vert(...parse(nb[1]));moves.push([v,(a[0]+b[0])/2,(a[1]+b[1])/2]);}
  for(const[v,x,z]of moves){v[0]+=(x-v[0])*k;v[1]+=(z-v[1])*k;}}
}

// Constraint-generated stack sample (compared against the hand-assembled masses): a base table plus
// 0-2 sub-blocks chosen by rule - a vertical combination (smaller, 1.25-1.6x higher block set inside
// the base -> a step) or a horizontal one (lower shoulder pushed past the rim -> a ledge/shoulder).
export function sampleApostleLobes({seed,rx,rz,h}){const r=rng(seed),L=[[0,0,rx,rz,h,r()*1.2]],n=Math.floor(r()*3);
 for(let k=0;k<n;k++){const a=r()*6.28;if(r()<.55){const f=.4+r()*.2;L.push([Math.cos(a)*rx*.35,Math.sin(a)*rz*.35,rx*f,rz*f,h*(1.25+r()*.35),r()]);}
  else{const f=.45+r()*.2;L.push([Math.cos(a)*rx*.95,Math.sin(a)*rz*.95,rx*f,rz*f,h*(.45+r()*.25),r()]);}}
 return L;}

