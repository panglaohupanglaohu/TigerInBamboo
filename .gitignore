# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
*.egg-info/

# 运行时生成的配置
backend/config.json

# Node（若后续引入构建工具）
node_modules/
dist/

# 大体积本地资产（不入库）
tools/TripoSR/
tools/out/
tools/crops/
pic/
tools/.shot/
# 乐曲资源：随前端一并发布
frontend/assets/audio/*.ogg

# 视频（太大，不入库）
*.mp4
*.MP4
*.mov
*.MOV

# OS / 编辑器
.DS_Store
.idea/
.vscode/

# 调试截图 / 缓存 / 大体积生成物（不入库）
.playwright-cli/
lab-*.png
video_xiaoman/
.dsh-recovery/

# e2e / 运行产物
tools/e2e/
frontend/scenes/*.json
backend/runtime.json

# 本机大模型凭据（只在 start.sh 启动时加载，禁止入库）
.env.local

# 私有记忆（含跨会话上下文，禁止入库）
.codebuddy/
.workbuddy/

# Godot 导出包（index.pck 265MB，超过 GitHub 100MB 硬限，不入库）
*.pck

# 本地静态服务状态与日志
**/.server.pid
**/.server.port
**/.server.log

# 渲染帧序列（coverage 帧截图海量小文件，单目录 6GB，不入库）
# 但评审报告（*.md）与浏览器回执（*.json）必须入库：学习工坊会把它们直接链到页面上，
# 只忽略目录不忽略这两类文件，否则每批新证据都会被静默丢弃，线上就是 404 与「证据已变化」。
townscaper-web/REACodeRefactoring/artifacts/coverage/**
!townscaper-web/REACodeRefactoring/artifacts/coverage/**/
!townscaper-web/REACodeRefactoring/artifacts/coverage/**/*.md
!townscaper-web/REACodeRefactoring/artifacts/coverage/**/*.json
townscaper-web/REACodeRefactoring/gifs/

# 临时删除暂存区（含 108MB 打包文件，超过 GitHub 100MB 硬限）
TigerMessenger/_to_delete/

# Python 虚拟环境（本地大模型依赖）
.venv*/
venv*/
.Python
